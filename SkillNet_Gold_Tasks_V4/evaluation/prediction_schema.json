{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillNet Codex Prediction",
  "$defs": {
    "departmentName": {
      "type": "string",
      "enum": [
        "Finance Agent",
        "Procurement Agent",
        "Technology Agent",
        "Business Agent",
        "HR Agent"
      ]
    },
    "skillName": {
      "type": "string",
      "enum": [
        "business-acceptance",
        "business-contract-signing",
        "business-customer-lead",
        "business-negotiation",
        "business-opportunity-assessment",
        "business-project-delivery-tracking",
        "business-renewal",
        "business-requirement-communication",
        "business-solution-quotation",
        "finance-accounting",
        "finance-budget-check",
        "finance-budget-planning",
        "finance-expense-request",
        "finance-expense-review",
        "finance-invoice-verification",
        "finance-payment-approval",
        "finance-reporting",
        "hr-employee-database",
        "hr-interview-scheduling",
        "hr-jd-generator",
        "hr-job-requirement",
        "hr-offer-generator",
        "hr-onboarding",
        "hr-recruitment-publish",
        "hr-resume-screening",
        "procurement-contract-generation",
        "procurement-delivery-acceptance",
        "procurement-delivery-tracking",
        "procurement-purchase-order",
        "procurement-quote-comparison",
        "procurement-requirement",
        "procurement-rfq-generation",
        "procurement-supplier-evaluation",
        "procurement-supplier-qualification",
        "procurement-supplier-scoring",
        "procurement-supplier-search",
        "procurement-supplier-selection",
        "technology-development-implementation",
        "technology-feasibility-assessment",
        "technology-operations-maintenance",
        "technology-requirement",
        "technology-solution-design",
        "technology-specification-confirmation",
        "technology-system-release",
        "technology-task-breakdown",
        "technology-test-acceptance"
      ]
    }
  },
  "type": "object",
  "required": [
    "task_id",
    "use_skills",
    "selected_departments",
    "skill_sequence",
    "final_status",
    "blocked_by",
    "route_choice",
    "reason"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "use_skills": {
      "type": "boolean"
    },
    "selected_departments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/departmentName"
      }
    },
    "skill_sequence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillName"
      }
    },
    "final_status": {
      "enum": [
        "completed",
        "blocked",
        "no_tool"
      ]
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillName"
      }
    },
    "route_choice": {
      "type": "object",
      "required": [
        "acceptance_route",
        "build_or_buy"
      ],
      "properties": {
        "acceptance_route": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "business_acceptance",
            "technical_acceptance",
            null
          ]
        },
        "build_or_buy": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "internal_development",
            "external_procurement",
            null
          ]
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
